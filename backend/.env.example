# Copy to .env for local development. Never commit the real .env file.

# Local Postgres started via `pnpm db:up` (see docker-compose.yml).
DATABASE_URL="postgresql://sylph:sylph@localhost:5432/sylph"

# HS256 signing secret for Sylph's own access tokens. Generate a real random value for
# anything beyond local dev, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-change-me"

# Public identifiers (NOT secrets) used to validate the `aud` claim on provider identity
# tokens. Apple's is the app's bundle ID / Sign in with Apple service ID; Google's is the
# OAuth client ID configured for this app.
APPLE_AUDIENCE="com.sylph.app"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id.apps.googleusercontent.com"

# Object storage (S3-compatible). Local dev uses MinIO started via `pnpm infra:up`; production
# points these at a real provider (AWS S3, Cloudflare R2, ...). The bucket is created
# automatically at boot if it doesn't exist yet. These credentials are server-side only — never
# shipped to the mobile client.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="sylph-dev"
S3_ACCESS_KEY_ID="sylph-dev"
S3_SECRET_ACCESS_KEY="sylph-dev-secret"
S3_FORCE_PATH_STYLE="true"

PORT=3000
NODE_ENV=development

# DANGER — local development only. When "true", exposes POST /v1/auth/dev-login, which mints a
# real session for a brand-new user with NO identity verification at all. It exists solely so
# the mobile app can be smoke-tested end-to-end before a real Apple/Google developer account is
# configured (docs/PRODUCT_AND_COMPLIANCE.md §7). The route does not exist (404) unless this is
# exactly "true", NODE_ENV is not "production" is also required, and the server logs a warning
# on boot whenever it's active. Never set this to "true" anywhere but a local machine.
ENABLE_DEV_AUTH=false
