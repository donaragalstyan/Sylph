# Copy to .env for local development. Never commit the real .env file.

# Local Postgres started via `pnpm db:up` (see docker-compose.yml).
DATABASE_URL="postgresql://sylph:sylph@localhost:5432/sylph"

# HS256 signing secret for Sylph's own access tokens. Generate a real random value for
# anything beyond local dev, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-change-me"

# Public identifiers (NOT secrets) used to validate the `aud` claim on provider identity
# tokens. Apple's is the app's bundle ID / Sign in with Apple service ID; Google's is the
# OAuth client ID configured for this app.
APPLE_AUDIENCE="com.sylph.app"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id.apps.googleusercontent.com"

PORT=3000
NODE_ENV=development
